<Window x:Class="BtChatWpf.DevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בחר מכשיר מזווג" Height="300" Width="320"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ListDevices" Grid.Row="0" DisplayMemberPath="DeviceName"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Button Content="התחבר" Width="80" Margin="0,0,8,0" Click="BtnConnect_Click" IsDefault="True"/>
            <Button Content="ביטול" Width="80" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
