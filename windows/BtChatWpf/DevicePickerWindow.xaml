<Window x:Class="BtChatWpf.DevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מכשיר חדש לצ'אט" Width="440" Height="480" MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI"
        Background="{StaticResource Surface}" Icon="/app.ico" ShowInTaskbar="False">
    <DockPanel Margin="18,14,18,14">
        <TextBlock DockPanel.Dock="Top" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"
                   Text="בחר מכשיר מזווג שעוד לא התחבר ל-BT Chat, או מכשיר חדש שנמצא בחיפוש. כדי שטלפון חדש יימצא, פתח בו את מסך הגדרות ה-Bluetooth."/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Margin="0,0,0,10" FontSize="12">
                <Hyperlink Click="LinkWindowsSettings_Click">אפשר גם לצמד דרך הגדרות ה-Bluetooth של Windows</Hyperlink>
            </TextBlock>
            <DockPanel>
                <Button x:Name="BtnSearch" DockPanel.Dock="Left" Content="חפש שוב" Click="BtnSearch_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPair" Content="צמד והתחבר" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="BtnPair_Click"/>
                    <Button Content="ביטול" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,6">
            <TextBlock x:Name="TxtState" Text="מחפש מכשירים..." Foreground="{StaticResource TextSub}" FontSize="12"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Margin="0,0,0,6"
                     BorderThickness="0" Foreground="{StaticResource Brand}" Background="{StaticResource BrandLight}"/>

        <ListBox x:Name="ListFound" BorderBrush="{StaticResource Line}" MouseDoubleClick="ListFound_MouseDoubleClick"
                 SelectionChanged="ListFound_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
